# mtrelay configuration. Every value below is a default — set only what you change.

# ---- listener ----
RELAY_LISTEN_HOST=0.0.0.0
RELAY_LISTEN_PORT=443
RELAY_CERT=/certs/fullchain.pem
RELAY_KEY=/certs/privkey.pem

# ---- subscriptions ----
RELAY_DB=/data/relay.db
RELAY_PIDFILE=/run/mtrelay.pid
# 1 keeps the original token-less client working (self-hosting).
# 0 means only subscribed clients are carried; everyone else is masked.
ALLOW_V1=1
# Shown to a customer whose subscription lapsed (inside the status frame).
RENEW_HINT=

# ---- cover site ----
# Where non-clients are sent. Without this they are dropped, which is itself a
# fingerprint — point it at a real site you host.
MASK_HOST=
MASK_PORT=0

# ---- Telegram datacenters ----
DC1=149.154.175.50
DC2=149.154.167.51
DC3=149.154.175.100
DC4=149.154.167.91
DC5=149.154.171.5
DC_PORT=443

# ---- timeouts (seconds) ----
TLS_HANDSHAKE_TIMEOUT=10
HEADER_TIMEOUT=20
# A real client sends its whole header in one TLS record, so this can be short.
BODY_TIMEOUT=5
# Without this a black-holed datacenter pins a coroutine and an fd indefinitely.
UPSTREAM_TIMEOUT=8

# ---- background cadence (seconds) ----
AUTH_RELOAD_SEC=15
METER_FLUSH_SEC=30
SWEEP_SEC=10

# ---- devices ----
# How long a device keeps its slot after its last socket closes. A client drops
# and reopens sockets constantly; without a grace window every reconnect would
# risk costing the customer a device slot.
DEVICE_GRACE_SEC=180
# strict = a new device over the limit is refused (and told so)
# lru     = the least recently active device is evicted instead
DEVICE_POLICY=strict

# ---- limits ----
MAX_CONNS=8192

# ---- logging ----
# off | prefix | full.
# 'prefix' logs a /24 (v4) or /48 (v6). Do not assume hashing full addresses
# would be safer: the IPv4 space is small enough that a hashed log is
# reversible by brute force, so a seized log would deanonymise every user.
LOG_IP=prefix
