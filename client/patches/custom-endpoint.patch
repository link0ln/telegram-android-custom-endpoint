+// ================= CUSTOM: genuine TLS to relay endpoint (SNI the configured host) =================
+void ConnectionSocket::realTlsInit() {
+    static SSL_CTX *ctx = nullptr;
+    if (ctx == nullptr) {
+        ctx = SSL_CTX_new(TLS_client_method());
+        SSL_CTX_set_min_proto_version(ctx, TLS1_2_VERSION);
+        SSL_CTX_set_verify(ctx, SSL_VERIFY_NONE, nullptr);   // relay cert not validated; MTProto stays E2E to the DC
+    }
+    SSL *ssl = SSL_new(ctx);
+    BIO *rb = BIO_new(BIO_s_mem());
+    BIO *wb = BIO_new(BIO_s_mem());
+    SSL_set_bio(ssl, rb, wb);
+    const std::string &sni = ConnectionsManager::relaySni;
+    SSL_set_tlsext_host_name(ssl, sni.empty() ? "www.microsoft.com" : sni.c_str());
+    SSL_set_connect_state(ssl);
+    sslHandle = ssl;
+    sslRbio = rb;
+    sslWbio = wb;
+    realTlsConnected = false;
+}
+
+// CUSTOM: base32 (RFC 4648, no padding) as printed to the customer. Skips
+// separators and repairs the 0/O 1/I 8/B confusions, which is unambiguous
+// because none of those digits are in the alphabet.
+static bool relayB32Decode(const std::string &text, uint8_t *out, size_t outLen) {
+    uint64_t buffer = 0;
+    int bits = 0;
+    size_t n = 0;
+    for (size_t i = 0; i < text.size(); i++) {
+        char c = text[i];
+        if (c >= 'a' && c <= 'z') {
+            c = (char) (c - 'a' + 'A');
+        }
+        if (c == '0') {
+            c = 'O';
+        } else if (c == '1') {
+            c = 'I';
+        } else if (c == '8') {
+            c = 'B';
+        }
+        int v;
+        if (c >= 'A' && c <= 'Z') {
+            v = c - 'A';
+        } else if (c >= '2' && c <= '7') {
+            v = c - '2' + 26;
+        } else {
+            continue;
+        }
+        buffer = (buffer << 5) | (uint64_t) v;
+        bits += 5;
+        if (bits >= 8) {
+            bits -= 8;
+            if (n >= outLen) {
+                return false;
+            }
+            out[n++] = (uint8_t) ((buffer >> bits) & 0xFF);
+        }
+    }
+    return n == outLen;
+}
+
+static bool relayHexDecode(const std::string &text, uint8_t *out, size_t outLen) {
+    if (text.size() != outLen * 2) {
+        return false;
+    }
+    for (size_t i = 0; i < outLen; i++) {
+        int hi = -1, lo = -1;
+        char a = text[i * 2], b = text[i * 2 + 1];
+        if (a >= '0' && a <= '9') hi = a - '0'; else if (a >= 'a' && a <= 'f') hi = a - 'a' + 10; else if (a >= 'A' && a <= 'F') hi = a - 'A' + 10;
+        if (b >= '0' && b <= '9') lo = b - '0'; else if (b >= 'a' && b <= 'f') lo = b - 'a' + 10; else if (b >= 'A' && b <= 'F') lo = b - 'A' + 10;
+        if (hi < 0 || lo < 0) {
+            return false;
+        }
+        out[i] = (uint8_t) ((hi << 4) | lo);
+    }
+    return true;
+}
+
+// CUSTOM: the relay certificate is not chain-verified here (see realTlsInit),
+// which was harmless while this channel carried only end-to-end encrypted
+// MTProto. It stops being harmless once a bearer token travels in it: without
+// this check an on-path attacker - exactly the adversary we exist to defeat -
+// could impersonate the relay and harvest tokens. The pin is learned by the
+// Java layer, which does verify properly. Empty pin = self-hosting, no check.
+bool ConnectionSocket::realTlsCheckPin() {
+    const std::string &pin = ConnectionsManager::relayPin;
+    if (pin.empty()) {
+        return true;
+    }
+    uint8_t want[32];
+    if (!relayHexDecode(pin, want, sizeof(want))) {
+        return true;   // malformed pin: fail open rather than brick the client
+    }
+    X509 *cert = SSL_get_peer_certificate((SSL *) sslHandle);
+    if (cert == nullptr) {
+        return false;
+    }
+    uint8_t *der = nullptr;
+    int derLen = i2d_X509_PUBKEY(X509_get_X509_PUBKEY(cert), &der);
+    bool ok = false;
+    if (derLen > 0 && der != nullptr) {
+        uint8_t got[32];
+        SHA256(der, (size_t) derLen, got);
+        ok = memcmp(got, want, sizeof(want)) == 0;
+        OPENSSL_free(der);
+    }
+    X509_free(cert);
+    if (!ok && LOGS_ENABLED) {
+        DEBUG_E("connection(%p) relay public key does not match the pin", this);
+    }
+    return ok;
+}
+
+// CUSTOM: 39-byte v2 hello: "TGR" + version + mode + token + device + ext_len.
+bool ConnectionSocket::realTlsBuildHello(uint8_t *out) {
+    uint8_t token[16], device[16];
+    if (!relayB32Decode(ConnectionsManager::relayToken, token, sizeof(token))) {
+        return false;
+    }
+    if (!relayHexDecode(ConnectionsManager::relayDeviceId, device, sizeof(device))) {
+        return false;
+    }
+    out[0] = 'T';
+    out[1] = 'G';
+    out[2] = 'R';
+    out[3] = 0x02;
+    out[4] = relayDcId;
+    memcpy(out + 5, token, 16);
+    memcpy(out + 21, device, 16);
+    out[37] = 0;
+    out[38] = 0;
+    return true;
+}
+
+void ConnectionSocket::realTlsFree() {
+    if (sslHandle != nullptr) {
+        SSL_free((SSL *) sslHandle);   // also frees the attached BIOs
+        sslHandle = nullptr;
+        sslRbio = nullptr;
+        sslWbio = nullptr;
+    }
+    realTlsConnected = false;
+    relayHelloState = 0;   // CUSTOM: never let handshake state outlive its connection
+    relayHelloLen = 0;
+}
+
+void ConnectionSocket::realTlsFlushOut() {
+    if (sslWbio == nullptr) return;
+    char buf[16384];
+    int n;
+    while ((n = BIO_read((BIO *) sslWbio, buf, sizeof(buf))) > 0) {
+        int off = 0;
+        while (off < n) {
+            ssize_t s = send(socketFd, buf + off, (size_t) (n - off), 0);
+            if (s <= 0) return;
+            off += (int) s;
+        }
+    }
+}
+
+bool ConnectionSocket::realTlsHandshakeStep() {
+    SSL *ssl = (SSL *) sslHandle;
+    if (ssl == nullptr) return false;
+    int r = SSL_do_handshake(ssl);
+    realTlsFlushOut();
+    if (r == 1) {
+        realTlsConnected = true;
+        if (LOGS_ENABLED) DEBUG_D("connection(%p) real TLS handshake complete, relay dc=%d", this, (int) relayDcId);
+        if (!realTlsCheckPin()) {
+            closeSocket(1, -1);
+            return false;
+        }
+        if (ConnectionsManager::relayToken.empty()) {
+            // CUSTOM: no subscription configured - keep the original 5-byte
+            // header so a self-hosted relay works exactly as before.
+            uint8_t routeHdr[5] = { 'T', 'G', 'R', '1', relayDcId };
+            SSL_write((SSL *) sslHandle, routeHdr, 5);
+            realTlsFlushOut();
+            relayHelloState = 2;
+            if (!onConnectedSent) {
+                lastEventTime = ConnectionsManager::getInstance(instanceNum).getCurrentTimeMonotonicMillis();
+                onConnected();
+                onConnectedSent = true;
+            }
+            adjustWriteOp();
+            return true;
+        }
+        uint8_t hello[39];
+        if (!realTlsBuildHello(hello)) {
+            if (LOGS_ENABLED) DEBUG_E("connection(%p) relay token/device id is malformed", this);
+            closeSocket(1, -1);
+            return false;
+        }
+        SSL_write((SSL *) sslHandle, hello, sizeof(hello));
+        realTlsFlushOut();
+        // CUSTOM: deliberately NOT calling onConnected() yet. tgnet would start
+        // pushing MTProto into a socket the relay may be about to drop, and the
+        // subscription verdict has not arrived. See realTlsOnReadable.
+        relayHelloState = 1;
+        adjustWriteOp();
+        return true;
+    }
+    int err = SSL_get_error(ssl, r);
+    if (err == SSL_ERROR_WANT_READ || err == SSL_ERROR_WANT_WRITE) {
+        adjustWriteOp();
+        return false;
+    }
+    if (LOGS_ENABLED) DEBUG_E("connection(%p) real TLS handshake fatal error %d", this, err);
+    closeSocket(1, -1);
+    return false;
+}
+
+void ConnectionSocket::realTlsOnReadable(uint8_t *data, int len) {
+    if (sslHandle == nullptr) realTlsInit();
+    BIO_write((BIO *) sslRbio, data, len);   // ciphertext consumed into rbio (data may now be overwritten)
+    if (!realTlsConnected) {
+        if (!realTlsHandshakeStep()) return;
+    }
+    if (relayHelloState == 1) {
+        // CUSTOM: the relay answers a v2 hello with one 10-byte frame before
+        // anything else. It may arrive split across epoll wakeups, so the
+        // partial is kept in relayHelloBuf. OK frames carry no payload, which
+        // is what keeps this a fixed-size read with no body state to track.
+        while (relayHelloLen < sizeof(relayHelloBuf)) {
+            SSL *ssl0 = (SSL *) sslHandle;
+            if (ssl0 == nullptr) {
+                return;
+            }
+            int n = SSL_read(ssl0, relayHelloBuf + relayHelloLen,
+                             (int) (sizeof(relayHelloBuf) - relayHelloLen));
+            if (n <= 0) {
+                return;
+            }
+            relayHelloLen += (uint8_t) n;
+        }
+        if (relayHelloBuf[0] != 'T' || relayHelloBuf[1] != 'G' ||
+            relayHelloBuf[2] != 'S' || relayHelloBuf[3] != '2') {
+            // Not our relay, or an unknown token was masked to the cover site
+            // and we are looking at that site's response. Both mean "no service
+            // here" and neither is distinguishable from the other by design.
+            if (LOGS_ENABLED) DEBUG_E("connection(%p) relay did not answer with a status frame", this);
+            closeSocket(1, -1);
+            return;
+        }
+        uint8_t stcode = relayHelloBuf[4];
+        uint16_t ttl = (uint16_t) ((relayHelloBuf[6] << 8) | relayHelloBuf[7]);
+        uint16_t plen = (uint16_t) ((relayHelloBuf[8] << 8) | relayHelloBuf[9]);
+        ConnectionsManager::writeRelayStatus(stcode, ttl);
+        if (stcode != 0 || plen != 0) {
+            if (LOGS_ENABLED) DEBUG_E("connection(%p) relay refused: status=%d ttl=%d", this, (int) stcode, (int) ttl);
+            closeSocket(1, -1);
+            return;
+        }
+        relayHelloState = 2;
+        if (!onConnectedSent) {
+            lastEventTime = ConnectionsManager::getInstance(instanceNum).getCurrentTimeMonotonicMillis();
+            onConnected();
+            onConnectedSent = true;
+        }
+        adjustWriteOp();
+    }
+    NativeByteBuffer *nb = ConnectionsManager::getInstance(instanceNum).networkBuffer;
+    while (true) {
+        SSL *ssl = (SSL *) sslHandle;   // CUSTOM: re-read each iter; onReceivedData() may closeSocket()->realTlsFree()
+        if (ssl == nullptr) break;      // CUSTOM: SSL freed underneath us -> stop (fixes use-after-free SIGSEGV)
+        nb->rewind();
+        int n = SSL_read(ssl, nb->bytes(), READ_BUFFER_SIZE);
+        if (n <= 0) break;
+        nb->limit((uint32_t) n);
+        onReceivedData(nb);
+    }
+}
+
+void ConnectionSocket::realTlsWrite(uint8_t *data, uint32_t len) {
+    if (sslHandle == nullptr) return;
+    SSL_write((SSL *) sslHandle, data, (int) len);
+    realTlsFlushOut();
+}
