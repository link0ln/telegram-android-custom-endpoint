+// CUSTOM: hand the subscription verdict to the Java layer.
+// Written to a temp file and renamed, because the Java side watches the
+// directory for an atomic move - watching the file itself would miss it.
+// Rate limited: tgnet reconnects hard when it is refused, and every attempt
+// produces the same answer.
+void ConnectionsManager::writeRelayStatus(uint8_t status, uint16_t ttlDays) {
+    if (relayStatusPath.empty()) {
+        return;
+    }
+    // Write immediately when the verdict CHANGES, and at most every 30s
+    // otherwise. tgnet retries hard when it is refused, so without this a
+    // single refusal would rewrite this file - and wake the Java watcher -
+    // once per reconnect, dozens of times a second.
+    static int64_t lastWrite = 0;
+    static int lastStatus = -1;
+    int64_t now = (int64_t) std::chrono::duration_cast<std::chrono::seconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+    if (status == lastStatus && now - lastWrite < 30) {
+        return;
+    }
+    lastWrite = now;
+    lastStatus = status;
+    std::string tmp = relayStatusPath + ".tmp";
+    FILE *f = fopen(tmp.c_str(), "w");
+    if (f == nullptr) {
+        return;
+    }
+    fprintf(f, "status=%d\nttl=%d\nts=%lld\n", (int) status, (int) ttlDays, (long long) now);
+    fclose(f);
+    rename(tmp.c_str(), relayStatusPath.c_str());
+}
